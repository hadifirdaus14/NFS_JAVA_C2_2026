###############################################################
# 2. HAPPY PATH - confirm things still work
###############################################################

### List tickets as ADMIN -> 200
GET {{baseUrl}}/api/v1/tickets
Authorization: Bearer {{adminToken}}

### List tickets as USER -> 200 (reading is allowed for both roles)
GET {{baseUrl}}/api/v1/tickets
Authorization: Bearer {{userToken}}

### Ticket status report as USER -> 200
GET {{baseUrl}}/api/v1/reports/tickets-by-status
Authorization: Bearer {{userToken}}

### Create a ticket as ADMIN -> 201
### Copy the "id" from the response into @ticketId below.
POST {{baseUrl}}/api/v1/tickets
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "title": "Day 17 error tracking ticket",
  "description": "Used to trigger the error cases below.",
  "category": "Testing",
  "priority": "LOW",
  "createdBy": "admin@example.com"
}

@ticketId = PASTE_TICKET_ID_HERE


###############################################################
# 3. EXERCISE 3 - the five errors to document
###############################################################

### ---- 401 Unauthorized: no token at all ----
GET {{baseUrl}}/api/v1/tickets

### ---- 401 Unauthorized: a token that is not valid ----
GET {{baseUrl}}/api/v1/tickets
Authorization: Bearer not.a.real.token


### ---- 403 Forbidden: USER tries to CREATE a ticket ----
### Reading is allowed for USER, changing is ADMIN only.
POST {{baseUrl}}/api/v1/tickets
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "title": "Ticket created by a normal user",
  "description": "A USER role should not be allowed to do this.",
  "category": "Testing",
  "priority": "LOW",
  "createdBy": "user@example.com"
}

### ---- 403 Forbidden: USER tries to UPDATE a ticket ----
PUT {{baseUrl}}/api/v1/tickets/{{ticketId}}
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "title": "Edited by a normal user",
  "description": "A USER role should not be allowed to do this either.",
  "category": "Testing",
  "priority": "HIGH",
  "status": "CLOSED"
}


### ---- 400 Bad Request: blank required field (@NotBlank) ----
PUT {{baseUrl}}/api/v1/tickets/{{ticketId}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "title": "",
  "description": "Title is blank so bean validation rejects the request.",
  "category": "Testing",
  "priority": "LOW",
  "status": "OPEN"
}


### ---- 404 Not Found: ticket id that does not exist ----
GET {{baseUrl}}/api/v1/tickets/000000000000000000000000
Authorization: Bearer {{adminToken}}

### ---- 404 Not Found: updating an id that does not exist ----
PUT {{baseUrl}}/api/v1/tickets/000000000000000000000000
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "title": "Ticket that is not there",
  "description": "Should not be found.",
  "category": "Testing",
  "priority": "LOW",
  "status": "OPEN"
}


### ---- 409 Conflict: rename a ticket to a title another ticket already uses ----
### Handled by GlobalExceptionHandler.handleDuplicateResource
### -> {"errors": [], "message": "Ticket title already exists: Cannot access email"}
PUT {{baseUrl}}/api/v1/tickets/6a6d91e979f4f37bef242422
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "title": "Laptop will not power on",
  "description": "This title already belongs to a seeded ticket.",
  "category": "Testing",
  "priority": "LOW",
  "status": "OPEN"
}


### ---- 400 Bad Request: invalid status (a business rule, not bean validation) ----
### Handled by GlobalExceptionHandler.handleInvalidRequest
### -> {"errors": [], "message": "Invalid status: BROKEN. Allowed statuses are: [...]"}
PUT {{baseUrl}}/api/v1/tickets/{{ticketId}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "title": "Day 17 error tracking ticket",
  "description": "BROKEN is not an allowed status.",
  "category": "Testing",
  "priority": "LOW",
  "status": "BROKEN"
}


###############################################################
# 4. Finding the errors in the logs
###############################################################
# Every request above prints one line from RequestTimingFilter, for example:
#
#   requestId=48d717cf method=PUT path=/api/v1/tickets/6a7f... status=403 durationMs=4
#
# The response also carries an X-Request-Id header with the same value,
# so you can match a response you saw in the client to its line in the log.
