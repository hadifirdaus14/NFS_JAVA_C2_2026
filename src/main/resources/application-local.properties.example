server.port=8080

spring.mongodb.host=localhost
spring.mongodb.port=27017
spring.mongodb.database=your_db
spring.mongodb.authentication-database=your_auth_db
spring.mongodb.username=app_user
spring.mongodb.password=pwd12345

spring.output.ansi.enabled=always
logging.level.com.example.assettracker=DEBUG

spring.jackson.serialization.indent-output=true
spring.web.error.include-message=always
spring.web.error.include-binding-errors=always